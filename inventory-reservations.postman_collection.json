    {
      "name": "Create reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 2XX\", function () {\n    try{\n        pm.response.to.have.status(201);\n    } catch(err){\n        if(pm.response.code == 409){\n            const m = /stockQuantity=([0-9]+)/gi.exec(pm.response.headers.get('X-Reservation-Details')||\"\");\n            if(m){\n                const stock = Number(m[1]);\n                if(!Number.isNaN(stock)){\n                    return;\n                }\n            }\n        }\n\n        throw err;\n    }\n});\nif (pm.response.code === 201) {\n    pm.collectionVariables.set(\"reservationId\", pm.response.json().id);\n}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = Math.floor(Math.random() * (10 - 1 + 1)) + 1;\npm.variables.set(\"randQ\", r);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Verbose",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": {{randQ}},\n  \"ttlSeconds\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        }
      },
      "response": []
    },
